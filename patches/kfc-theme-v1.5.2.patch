+/* ============================================================
+ * KFC 疯狂星期四主题（storefront_template = kfc）
+ * 保持 classic 布局结构，仅覆盖配色与装饰元素。
+ * ============================================================ */
+
+.template-kfc {
+  --ui-bg-page: #f4f1ea;
+  --ui-bg-elevated: #fffdf8;
+  --ui-bg-soft: #f7f3ea;
+  --ui-bg-muted: #efe9dd;
+  --ui-bg-overlay: rgba(255, 253, 248, 0.85);
+  --ui-bg-overlay-strong: rgba(255, 253, 248, 0.94);
+  --ui-text-primary: #121212;
+  --ui-text-secondary: #3d3d38;
+  --ui-text-muted: #6b6b62;
+  --ui-border: rgba(18, 18, 18, 0.14);
+  --ui-border-strong: rgba(18, 18, 18, 0.24);
+  --ui-accent: #c41200;
+  --ui-accent-hover: #a30f00;
+  --ui-accent-soft: rgba(196, 18, 0, 0.12);
+  --ui-focus-ring: rgba(196, 18, 0, 0.24);
+  --ui-price-promotion: #c41200;
+  background: #f4f1ea;
+}
+
+.dark .template-kfc {
+  --ui-bg-page: #0a0a0a;
+  --ui-bg-elevated: #141414;
+  --ui-bg-soft: #1a1a1a;
+  --ui-bg-muted: #202020;
+  --ui-bg-overlay: rgba(20, 20, 20, 0.85);
+  --ui-bg-overlay-strong: rgba(20, 20, 20, 0.94);
+  --ui-text-primary: #ededed;
+  --ui-text-secondary: #cfcfc8;
+  --ui-text-muted: #9a9a90;
+  --ui-border: rgba(255, 199, 44, 0.18);
+  --ui-border-strong: rgba(255, 199, 44, 0.3);
+  --ui-accent: #ffc72c;
+  --ui-accent-hover: #ffd45c;
+  --ui-accent-soft: rgba(255, 199, 44, 0.14);
+  --ui-focus-ring: rgba(255, 199, 44, 0.26);
+  --ui-price-promotion: #ffc72c;
+  --ui-text-on-accent: #121212;
+}
+
+.template-kfc .kfc-topbanner {
+  position: relative;
+  background: linear-gradient(135deg, #c41200, #ff7a3c);
+  color: #fff;
+  padding: 9px 14px;
+  font-size: 13px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 10px;
+  line-height: 1.4;
+}
+
+.template-kfc .kfc-topbanner-quote {
+  display: -webkit-box;
+  -webkit-line-clamp: 2;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+  text-align: center;
+  font-weight: 600;
+}
+
+.template-kfc .kfc-topbanner-cta {
+  flex-shrink: 0;
+  display: inline-flex;
+  align-items: center;
+  padding: 3px 10px;
+  border-radius: 0;
+  background: #ffc72c;
+  color: #121212;
+  font-weight: 700;
+  font-size: 12px;
+  white-space: nowrap;
+  transition: transform 0.15s ease;
+}
+
+.template-kfc .kfc-topbanner-cta:hover {
+  transform: scale(1.04);
+}
+
+.template-kfc .kfc-marquee {
+  overflow: hidden;
+  background: #ffc72c;
+  padding: 6px 0;
+}
+
+.template-kfc .kfc-marquee-track {
+  display: inline-flex;
+  white-space: nowrap;
+  color: #121212;
+  font-weight: 700;
+  font-size: 13px;
+  animation: kfc-marquee-scroll 28s linear infinite;
+}
+
+@keyframes kfc-marquee-scroll {
+  from { transform: translateX(0); }
+  to { transform: translateX(-50%); }
+}
+
+.template-kfc .fixed.top-0.left-0 {
+  position: relative !important;
+  background: #121212 !important;
+  border-bottom-color: rgba(255, 199, 44, 0.25) !important;
+}
+
+.template-kfc .pt-24,
+.template-kfc .pt-32,
+.template-kfc .pt-20,
+.template-kfc .md\:pt-36 {
+  padding-top: 0 !important;
+}
+
+.template-kfc .products-page .mt-12 {
+  margin-top: 0 !important;
+}
+
+.template-kfc .theme-wordmark {
+  background: transparent !important;
+  border-radius: 999px !important;
+  border-color: #ffc72c !important;
+  box-shadow: none !important;
+  padding: 4px 14px !important;
+}
+
+.template-kfc .fixed.top-0.left-0 a:not(.text-destructive),
+.template-kfc .fixed.top-0.left-0 button:not(.text-destructive) {
+  color: #ededed;
+}
+
+.template-kfc .fixed.top-0.left-0 a:hover,
+.template-kfc .fixed.top-0.left-0 button:hover {
+  color: #ffc72c;
+}
+
+/* vme.im style section label: tilted yellow tag with black border */
+.template-kfc .home-page .theme-section-heading,
+.template-kfc .products-page h1 {
+  display: inline-block;
+  background: #ffc72c;
+  color: #000;
+  border: 2px solid #000;
+  border-radius: 0;
+  padding: 4px 12px;
+  font-size: 24px;
+  font-weight: 900;
+  letter-spacing: 0.02em;
+  transform: rotate(2deg);
+  box-shadow: none;
+}
+
+/* vme.im style nav: active item = red bg white text (in utilities layer to win over !text-primary) */
+@layer utilities {
+  .template-kfc .fixed.top-0.left-0 div[class*="space-x-1"] a.router-link-active:not(.theme-wordmark),
+  .template-kfc .fixed.top-0.left-0 div[class*="space-x-1"] a.router-link-exact-active:not(.theme-wordmark) {
+    background: #c41200 !important;
+    color: #fff !important;
+    padding: 8px 14px !important;
+    border-radius: 0 !important;
+  }
+
+  .template-kfc .fixed.top-0.left-0 div[class*="space-x-1"] a.router-link-active svg,
