+}
+
+.template-kfc .kfc-hero-online-dot {
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: #ff4d4f;
+}
+
+.template-kfc .kfc-hero-cta {
+  display: inline-flex;
+  padding: 4px 12px;
+  background: #ffffff;
+  color: #000;
+  font-weight: 900;
+  font-size: 14px;
+  border-radius: 0;
+  border: 2px solid #000;
+  box-shadow: 2px 2px 0 #000;
+  transition: transform 0.15s ease, box-shadow 0.15s ease;
+}
+
+.template-kfc .kfc-hero-cta:hover {
+  transform: translateY(-1px);
+  box-shadow: 3px 3px 0 #000;
+  color: #000;
+}
+
+.dark .template-kfc .kfc-hero {
+  background: #0a0a0a;
+}
+
+.dark .template-kfc .kfc-hero-title {
+  color: #ededed;
+}
+
+.dark .template-kfc .kfc-hero-sub {
+  color: #9a9a90;
+}
+
+.dark .template-kfc .kfc-hero-cta {
+  background: #ffffff;
+  color: #121212;
+  border-color: #ededed;
+  box-shadow: 3px 3px 0 rgba(255, 199, 44, 0.45);
+}
+
+.dark .template-kfc .kfc-hero-online {
+  color: #9a9a90;
+}
